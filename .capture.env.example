# capture-ctl configuration. Copy to .capture.env and adjust for your network.
# .capture.env is git-ignored. No credentials required (diversion is firewall DNAT).

# ssh host alias for the OpenWrt router (configure in ~/.ssh/config)
ROUTER_SSH=firewall

# mitmproxy: bind, port, addon script, log verbosity (0-3)
MITM_LISTEN_HOST=0.0.0.0
MITM_PORT=46030
MITM_ADDON=lg_portfix.py
FLOW_DETAIL=2

# capture host (this machine's LAN IP), host used for the self-test,
# and the appliances to divert (space-separated LAN IPs).
# Replace these with YOUR actual IPs:
TARGET_IP=192.168.1.100
CHECK_HOST=eic.lgthinq.com
APPLIANCES="192.168.1.50 192.168.1.51"
