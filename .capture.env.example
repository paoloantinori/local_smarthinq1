# capture-ctl configuration. Copy to .capture.env and adjust if needed.
# .capture.env is git-ignored. No credentials required (diversion is firewall DNAT).

# ssh host alias for the OpenWrt router
ROUTER_SSH=firewall

# mitmproxy: bind, port, addon script, log verbosity (0-3)
MITM_LISTEN_HOST=0.0.0.0
MITM_PORT=46030
MITM_ADDON=lg_portfix.py
FLOW_DETAIL=2

# capture host (this machine), host used for the self-test, appliances to divert
TARGET_IP=192.168.20.CAPTURE
CHECK_HOST=eic.lgthinq.com
APPLIANCES="192.168.20.WASHER 192.168.20.DRYER"
